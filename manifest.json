{
  "manifest_version": 3,
  "name": "Coursera Timer Bypass",
  "version": "1.0.2",
  "description": "Advanced Coursera automation suite: Bypass timers, bulk open readings, and auto-manage video playbacks.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*",
        "file://*/*.html",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.coursera.org/*",
        "file://*/*.html",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
